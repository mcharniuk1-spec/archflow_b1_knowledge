{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arch-flow.dev/schemas/communication-packet.schema.json",
  "title": "ArchFlow portable communication packet",
  "type": "object",
  "required": [
    "schema_version",
    "packet_id",
    "run_id",
    "state",
    "role_id",
    "task",
    "claimed_files",
    "allowed_actions",
    "forbidden_actions",
    "expected_output",
    "blockers",
    "checks",
    "remaining_gaps",
    "next_safe_action",
    "created_at",
    "provider_calls",
    "external_writes",
    "public_safe"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "packet_id": {"type": "string", "minLength": 1},
    "parent_packet_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "state": {"enum": ["starting", "update", "complete", "blocked", "handoff"]},
    "role_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "task": {"type": "string", "minLength": 1},
    "claimed_files": {"$ref": "#/$defs/repo_paths"},
    "changed_files": {"$ref": "#/$defs/repo_paths"},
    "allowed_actions": {"$ref": "#/$defs/strings"},
    "forbidden_actions": {"$ref": "#/$defs/strings"},
    "expected_output": {"type": "string", "minLength": 1},
    "evidence_refs": {"$ref": "#/$defs/repo_paths"},
    "blockers": {"$ref": "#/$defs/strings"},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {"enum": ["pass", "fail", "skipped", "pending"]},
          "reason": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "remaining_gaps": {"$ref": "#/$defs/strings"},
    "next_safe_action": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "provider_calls": {"type": "integer", "minimum": 0},
    "external_writes": {"type": "integer", "minimum": 0},
    "public_safe": {"const": true}
  },
  "$defs": {
    "strings": {
      "type": "array",
      "items": {"type": "string"}
    },
    "repo_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "not": {"pattern": "^(?:/|[A-Za-z]:[\\\\/]|file:)"}
      }
    }
  },
  "additionalProperties": false
}
