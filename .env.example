# ArchFlow server-side placeholders only. Keep real values in the hosting
# platform, OS keychain, or an approved secret manager. Never expose them to
# browser code or commit a populated copy of this file.

# Administrator authentication. Missing configuration fails closed.
ARCHFLOW_AUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
ARCHFLOW_AUTH_ORIGIN=
ARCHFLOW_AUTH_SECRET=
ARCHFLOW_AUTH_SESSION_EPOCH=
ARCHFLOW_ADMIN_GOOGLE_SUBJECTS=
ARCHFLOW_ADMIN_EMAILS=
ARCHFLOW_AUTH_SESSION_TTL_SECONDS=14400

# Optional provider and observability credentials. These names prepare the
# integration boundary; they do not activate an adapter.
ARCHFLOW_PROVIDER_MODE=none
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

# Optional local adapter settings. No default model is serialized.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=
OLLAMA_EMBED_MODEL=
