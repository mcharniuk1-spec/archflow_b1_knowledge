{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/archflow/knowledge-case.schema.json",
  "title": "ArchFlow Knowledge Case",
  "type": "object",
  "required": ["schema_version", "case_id", "workflow_state", "goal", "authority", "source_boundary", "evidence", "requirements", "decisions", "contradictions", "gaps", "approvals", "results", "review", "knowledge"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "case_id": {"type": "string", "pattern": "^case-[a-z0-9-]+$"},
    "workflow_state": {"type": "string"},
    "goal": {
      "type": "object",
      "required": ["requested_outcome", "done_conditions", "non_goals", "stop_conditions"],
      "properties": {
        "requested_outcome": {"type": "string", "minLength": 1},
        "done_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "non_goals": {"type": "array", "items": {"type": "string"}},
        "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "required": ["requester_role", "accountable_owner_role", "maker_role", "reviewer_role", "allowed_actions", "forbidden_actions"],
      "properties": {
        "requester_role": {"type": "string"},
        "accountable_owner_role": {"type": "string"},
        "maker_role": {"type": "string"},
        "reviewer_role": {"type": "string"},
        "allowed_actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["actor_role", "operation", "target_class", "target_prefixes", "approval_class"],
            "properties": {
              "actor_role": {"type": "string"},
              "operation": {"type": "string"},
              "target_class": {"type": "string"},
              "target_prefixes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "approval_class": {"enum": ["none", "target_specific_owner"]}
            },
            "additionalProperties": false
          }
        },
        "forbidden_actions": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "source_boundary": {
      "type": "object",
      "required": ["allowed_source_classes", "excluded_source_classes", "status"],
      "properties": {
        "allowed_source_classes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "excluded_source_classes": {"type": "array", "items": {"type": "string"}},
        "status": {"enum": ["valid", "blocked"]}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "source_ref", "state", "claim_status", "owner_role", "observed_at", "review_by"],
        "properties": {
          "id": {"type": "string"},
          "source_ref": {"type": "string"},
          "state": {"enum": ["current", "stale", "superseded", "unknown"]},
          "claim_status": {"enum": ["fact", "interpretation", "hypothesis", "gap"]},
          "owner_role": {"type": "string"},
          "observed_at": {"type": "string"},
          "review_by": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "version", "state", "statement", "owner_role", "reviewer_role", "evidence_refs", "claim_status", "acceptance_checks", "review_by"],
        "properties": {
          "id": {"type": "string", "pattern": "^REQ-[A-Z0-9-]+$"},
          "version": {"type": "string"},
          "state": {"enum": ["proposed", "reviewed", "approved", "rejected", "superseded", "blocked", "gap"]},
          "statement": {"type": "string", "minLength": 1},
          "owner_role": {"type": "string"},
          "reviewer_role": {"type": "string"},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "claim_status": {"enum": ["fact", "interpretation", "hypothesis", "gap"]},
          "acceptance_checks": {"type": "array", "items": {"type": "string"}},
          "review_by": {"type": "string"},
          "superseded_by": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "decisions": {"type": "array", "items": {"type": "object"}},
    "contradictions": {"type": "array", "items": {"type": "object"}},
    "gaps": {"type": "array", "items": {"type": "object"}},
    "approvals": {"type": "array", "items": {"type": "object"}},
    "results": {"type": "array", "items": {"type": "object"}},
    "review": {
      "type": "object",
      "required": ["phase", "verdict", "maker_role", "reviewer_role"],
      "properties": {
        "phase": {"type": "string"},
        "verdict": {"enum": ["pending", "approved", "revise", "blocked"]},
        "maker_role": {"type": "string"},
        "reviewer_role": {"type": "string"}
      },
      "additionalProperties": false
    },
    "knowledge": {
      "type": "object",
      "required": ["promotion_status", "freshness_owner"],
      "properties": {
        "promotion_status": {"enum": ["not_proposed", "review", "promoted", "rejected"]},
        "freshness_owner": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
