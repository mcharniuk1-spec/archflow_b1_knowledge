{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/archflow/knowledge-case.schema.json",
  "title": "ArchFlow Knowledge Case",
  "type": "object",
  "required": ["schema_version", "case_version", "case_id", "workflow_state", "display_phase", "goal", "authority", "source_boundary", "evidence", "claims", "requirements", "decisions", "contradictions", "gaps", "tasks", "role_task_bindings", "approvals", "results", "receipts", "review", "knowledge"],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "case_version": {"type": "string", "pattern": "^[0-9]+$"},
    "case_id": {"type": "string", "pattern": "^case-[a-z0-9-]+$"},
    "workflow_state": {"enum": ["request_received", "admission_checked", "context_bound", "evidence_gathering", "evidence_reconciled", "requirements_review", "requirements_approved", "support_ready", "work_planning", "candidate_in_progress", "candidate_review", "proposal_ready", "proposal_validated", "approval_wait", "execution_ready", "executed", "result_verification", "accepted_result", "promotion_review", "promoted", "repair", "answered", "closed_no_promotion", "blocked", "failed", "stopped", "closed"]},
    "display_phase": {"enum": ["orient", "perceive", "commit", "work", "gate", "learn"]},
    "goal": {
      "type": "object",
      "required": ["requested_outcome", "done_conditions", "non_goals", "stop_conditions"],
      "properties": {
        "requested_outcome": {"type": "string", "minLength": 1},
        "done_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "non_goals": {"type": "array", "items": {"type": "string"}},
        "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "required": ["requester_role", "accountable_owner_role", "maker_role", "reviewer_role", "allowed_actions", "forbidden_actions"],
      "properties": {
        "requester_role": {"type": "string"},
        "accountable_owner_role": {"type": "string"},
        "maker_role": {"type": "string"},
        "reviewer_role": {"type": "string"},
        "allowed_actions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["actor_role", "operation", "target_class", "target_prefixes", "approval_class"],
            "properties": {
              "actor_role": {"type": "string"},
              "operation": {"type": "string"},
              "target_class": {"type": "string"},
              "target_prefixes": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "approval_class": {"enum": ["none", "target_specific_owner"]}
            },
            "additionalProperties": false
          }
        },
        "forbidden_actions": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "source_boundary": {
      "type": "object",
      "required": ["allowed_source_classes", "excluded_source_classes", "status"],
      "properties": {
        "allowed_source_classes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "excluded_source_classes": {"type": "array", "items": {"type": "string"}},
        "status": {"enum": ["valid", "blocked"]}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "source_ref", "state", "claim_status", "owner_role", "observed_at", "review_by", "exact_read"],
        "properties": {
          "id": {"type": "string"},
          "source_ref": {"type": "string"},
          "state": {"enum": ["current", "stale", "superseded", "unknown"]},
          "claim_status": {"enum": ["fact", "interpretation", "hypothesis", "gap"]},
          "owner_role": {"type": "string"},
          "observed_at": {"type": "string"},
          "review_by": {"type": "string"},
          "exact_read": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement", "status", "evidence_refs", "owner_role", "allowed_use"],
        "properties": {
          "id": {"type": "string", "pattern": "^CLAIM-[A-Z0-9-]+$"},
          "statement": {"type": "string", "minLength": 1},
          "status": {"enum": ["fact", "interpretation", "hypothesis", "gap"]},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "counter_evidence_refs": {"type": "array", "items": {"type": "string"}},
          "owner_role": {"type": "string"},
          "allowed_use": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "version", "state", "statement", "owner_role", "reviewer_role", "evidence_refs", "claim_status", "acceptance_checks", "review_by"],
        "properties": {
          "id": {"type": "string", "pattern": "^REQ-[A-Z0-9-]+$"},
          "version": {"type": "string"},
          "state": {"enum": ["proposed", "reviewed", "approved", "rejected", "superseded", "blocked", "gap"]},
          "statement": {"type": "string", "minLength": 1},
          "owner_role": {"type": "string"},
          "reviewer_role": {"type": "string"},
          "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "claim_status": {"enum": ["fact", "interpretation", "hypothesis", "gap"]},
          "acceptance_checks": {"type": "array", "items": {"type": "string"}},
          "review_by": {"type": "string"},
          "superseded_by": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "version", "state", "statement", "owner_role", "evidence_refs"],
        "properties": {
          "id": {"type": "string", "pattern": "^DEC-[A-Z0-9-]+$"},
          "version": {"type": "string"},
          "state": {"enum": ["proposed", "approved", "rejected", "superseded", "blocked"]},
          "statement": {"type": "string", "minLength": 1},
          "owner_role": {"type": "string"},
          "evidence_refs": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "state", "item_refs", "owner_role", "resolution"],
        "properties": {
          "id": {"type": "string", "pattern": "^CONTRA-[A-Z0-9-]+$"},
          "state": {"enum": ["open", "resolved", "accepted_exception"]},
          "item_refs": {"type": "array", "minItems": 2, "items": {"type": "string"}},
          "owner_role": {"type": "string"},
          "resolution": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "status", "statement", "blocks", "owner_role", "close_evidence_required"],
        "properties": {
          "id": {"type": "string", "pattern": "^GAP-[A-Z0-9-]+$"},
          "status": {"enum": ["open", "closed", "accepted"]},
          "statement": {"type": "string", "minLength": 1},
          "blocks": {"type": "array", "items": {"type": "string"}},
          "owner_role": {"type": "string"},
          "close_evidence_required": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "state", "owner_role", "reviewer_role", "requirement_refs", "output_ref", "readback"],
        "properties": {
          "id": {"type": "string", "pattern": "^TASK-[A-Z0-9-]+$"},
          "state": {"enum": ["proposed", "ready", "in_progress", "review", "repair", "accepted", "blocked", "stopped"]},
          "owner_role": {"type": "string"},
          "reviewer_role": {"type": "string"},
          "requirement_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "output_ref": {"type": "string", "minLength": 1},
          "readback": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "role_task_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["binding_id", "case_id", "workflow_pack_id", "base_or_closure", "role_id", "call_name", "role_goal", "inputs", "source_refs", "requirement_refs", "owned_output", "expected_output", "allowed_skills", "allowed_tools", "permission_boundary", "forbidden_actions", "exact_targets", "deterministic_checks", "known_gaps", "reviewer_route", "handoff", "stop_conditions"],
        "properties": {
          "binding_id": {"type": "string", "pattern": "^binding-[a-z0-9-]+$"},
          "case_id": {"type": "string", "pattern": "^case-[a-z0-9-]+$"},
          "workflow_pack_id": {"type": "string", "minLength": 1},
          "base_or_closure": {"enum": ["base", "review_closure"]},
          "role_id": {"type": "string", "minLength": 1},
          "call_name": {"type": "string", "pattern": "^[A-Za-z]+$"},
          "role_goal": {"type": "string", "minLength": 1},
          "inputs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "source_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "requirement_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "owned_output": {"type": "string", "minLength": 1},
          "expected_output": {"type": "string", "minLength": 1},
          "allowed_skills": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "allowed_tools": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "permission_boundary": {
            "type": "object",
            "required": ["authority_ref", "mode", "exact_targets_ref", "forbidden_actions_ref", "rule"],
            "properties": {
              "authority_ref": {"const": "case.authority"},
              "mode": {"enum": ["read_draft_only", "local_mutation_exact_targets", "review_only_frozen_candidate", "verification_only_no_repair", "knowledge_candidate_only", "browser_local_only", "observation_only", "external_action_exact_approval", "git_action_exact_approval"]},
              "exact_targets_ref": {"const": "binding.exact_targets"},
              "forbidden_actions_ref": {"type": "string", "pattern": "^role_catalog\\.roles\\.[a-z0-9_]+\\.forbidden$"},
              "rule": {"const": "intersection_only_no_authority_expansion"}
            },
            "additionalProperties": false
          },
          "forbidden_actions": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "exact_targets": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "deterministic_checks": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "known_gaps": {"type": "array", "items": {"type": "string", "pattern": "^GAP-[A-Z0-9-]+$"}},
          "reviewer_route": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "handoff": {
            "type": "object",
            "required": ["to", "payload"],
            "properties": {
              "to": {"type": "string", "minLength": 1},
              "payload": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
            },
            "additionalProperties": false
          },
          "stop_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "action_ref", "state", "owner_role", "exact_target", "reviewed_at"],
        "properties": {
          "id": {"type": "string", "pattern": "^APPROVAL-[A-Z0-9-]+$"},
          "action_ref": {"type": "string", "minLength": 1},
          "state": {"enum": ["pending", "approved", "rejected", "expired"]},
          "owner_role": {"type": "string"},
          "exact_target": {"type": "string", "minLength": 1},
          "reviewed_at": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "state", "artifact_refs", "verification", "readback"],
        "properties": {
          "id": {"type": "string", "pattern": "^RESULT-[A-Z0-9-]+$"},
          "state": {"enum": ["candidate", "verified", "accepted", "rejected", "rolled_back"]},
          "artifact_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "verification": {"type": "string", "minLength": 1},
          "readback": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "receipts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "state", "source_refs", "recorded_at"],
        "properties": {
          "id": {"type": "string", "pattern": "^RECEIPT-[A-Z0-9-]+$"},
          "kind": {"enum": ["admission", "retrieval", "verification", "approval", "action", "readback", "promotion"]},
          "state": {"enum": ["recorded", "verified", "superseded", "invalid"]},
          "source_refs": {"type": "array", "items": {"type": "string"}},
          "recorded_at": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "review": {
      "type": "object",
      "required": ["phase", "verdict", "maker_role", "reviewer_role"],
      "properties": {
        "phase": {"type": "string"},
        "verdict": {"enum": ["pending", "approved", "revise", "blocked"]},
        "maker_role": {"type": "string"},
        "reviewer_role": {"type": "string"}
      },
      "additionalProperties": false
    },
    "knowledge": {
      "type": "object",
      "required": ["promotion_status", "freshness_owner"],
      "properties": {
        "promotion_status": {"enum": ["not_proposed", "review", "promoted", "rejected"]},
        "freshness_owner": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
