{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/archflow/role-task-binding.schema.json",
  "title": "ArchFlow Role Task Binding V3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "binding_id",
    "case_id",
    "role_pack_id",
    "role_id",
    "owned_output",
    "allowed_skills",
    "allowed_tools",
    "permission_mode",
    "reviewer_role_id",
    "exact_targets",
    "stop_conditions"
  ],
  "properties": {
    "schema_version": {"const": "3.0"},
    "binding_id": {"type": "string", "pattern": "^binding-[a-z0-9-]+$"},
    "case_id": {"type": "string", "pattern": "^case-[a-z0-9-]+$"},
    "role_pack_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "role_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "owned_output": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "allowed_skills": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}
    },
    "allowed_tools": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    },
    "permission_mode": {
      "enum": [
        "read_draft_only",
        "local_mutation_exact_targets",
        "review_only_frozen_candidate",
        "verification_only_no_repair",
        "knowledge_candidate_only",
        "browser_local_only",
        "observation_only",
        "external_action_exact_approval",
        "git_action_exact_approval"
      ]
    },
    "reviewer_role_id": {"type": "string", "pattern": "^(@case_owner|[a-z][a-z0-9_]*)$"},
    "exact_targets": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\)[A-Za-z0-9._/-]+$"}
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
