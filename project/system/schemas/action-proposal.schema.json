{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/archflow/action-proposal.schema.json",
  "title": "ArchFlow Action Proposal V3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "case_id",
    "actor_role",
    "intent",
    "target",
    "change_set",
    "requirement_refs",
    "decision_refs",
    "coverage",
    "permission_scope",
    "side_effects",
    "effect_budget",
    "execute",
    "reversibility",
    "rollback",
    "verification_plan",
    "review",
    "approval"
  ],
  "properties": {
    "schema_version": {"const": "3.0"},
    "proposal_id": {"type": "string", "pattern": "^proposal-[a-z0-9-]+$"},
    "case_id": {"type": "string", "pattern": "^case-[a-z0-9-]+$"},
    "actor_role": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "intent": {"type": "string", "minLength": 1},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "ref"],
      "properties": {
        "class": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "ref": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\)[A-Za-z0-9._/-]+$"}
      }
    },
    "change_set": {"type": "string", "minLength": 1},
    "requirement_refs": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^REQ-[A-Z0-9-]+@[1-9][0-9]*$"}
    },
    "decision_refs": {
      "type": "array",
      "items": {"type": "string", "pattern": "^DEC-[A-Z0-9-]+@[1-9][0-9]*$"}
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requirement_ref", "status"],
        "properties": {
          "requirement_ref": {"type": "string", "pattern": "^REQ-[A-Z0-9-]+@[1-9][0-9]*$"},
          "status": {"enum": ["satisfied", "unaffected", "exception", "gap"]}
        }
      }
    },
    "permission_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "target_class", "status"],
      "properties": {
        "operation": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "target_class": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "status": {"enum": ["allowed", "not_allowed", "unknown"]}
      }
    },
    "side_effects": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    },
    "effect_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_calls", "network_calls", "external_writes"],
      "properties": {
        "provider_calls": {"const": 0},
        "network_calls": {"const": 0},
        "external_writes": {"const": 0}
      }
    },
    "execute": {"const": false},
    "reversibility": {"enum": ["reversible", "compensatable", "irreversible"]},
    "rollback": {"type": "string", "minLength": 1},
    "verification_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["preflight", "postcondition", "readback"],
      "properties": {
        "preflight": {"type": "string", "minLength": 1},
        "postcondition": {"type": "string", "minLength": 1},
        "readback": {"type": "string", "minLength": 1}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maker_role", "reviewer_role", "risk"],
      "properties": {
        "maker_role": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "reviewer_role": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "risk": {"enum": ["low", "medium", "high"]}
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status"],
      "properties": {
        "required": {"type": "boolean"},
        "status": {"enum": ["not_required", "missing", "approved", "expired", "rejected"]}
      }
    }
  }
}
