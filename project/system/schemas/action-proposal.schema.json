{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/archflow/action-proposal.schema.json",
  "title": "ArchFlow Action Proposal",
  "type": "object",
  "required": ["schema_version", "proposal_id", "case_id", "actor_role", "intent", "target", "change_set", "requirement_refs", "decision_refs", "coverage", "permission_scope", "side_effects", "reversibility", "rollback", "verification_plan", "review", "approval"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "proposal_id": {"type": "string", "pattern": "^proposal-[a-z0-9-]+$"},
    "case_id": {"type": "string", "pattern": "^case-[a-z0-9-]+$"},
    "actor_role": {"type": "string", "minLength": 1},
    "intent": {"type": "string", "minLength": 1},
    "target": {
      "type": "object",
      "required": ["class", "ref"],
      "properties": {"class": {"type": "string"}, "ref": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\.\\.)[A-Za-z0-9._/-]+$"}},
      "additionalProperties": false
    },
    "change_set": {"type": "string", "minLength": 1},
    "requirement_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^REQ-[A-Z0-9-]+@[A-Za-z0-9.-]+$"}},
    "decision_refs": {"type": "array", "items": {"type": "string"}},
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["requirement_ref", "status"],
        "properties": {"requirement_ref": {"type": "string"}, "status": {"enum": ["satisfied", "unaffected", "exception", "gap"]}},
        "additionalProperties": false
      }
    },
    "permission_scope": {
      "type": "object",
      "required": ["operation", "target_class", "status"],
      "properties": {"operation": {"type": "string"}, "target_class": {"type": "string"}, "status": {"enum": ["allowed", "not_allowed", "unknown"]}},
      "additionalProperties": false
    },
    "side_effects": {"type": "array", "items": {"type": "string"}},
    "reversibility": {"enum": ["reversible", "compensatable", "irreversible"]},
    "rollback": {"type": "string", "minLength": 1},
    "verification_plan": {
      "type": "object",
      "required": ["preflight", "postcondition", "readback"],
      "properties": {"preflight": {"type": "string", "minLength": 1}, "postcondition": {"type": "string", "minLength": 1}, "readback": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": ["maker_role", "reviewer_role", "risk"],
      "properties": {"maker_role": {"type": "string"}, "reviewer_role": {"type": "string"}, "risk": {"enum": ["low", "medium", "high"]}},
      "additionalProperties": false
    },
    "approval": {
      "type": "object",
      "required": ["required", "status"],
      "properties": {"required": {"type": "boolean"}, "status": {"enum": ["not_required", "missing", "approved", "expired", "rejected"]}},
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
