{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arch-flow.dev/schemas/solution-memory-record.schema.json",
  "title": "ArchFlow reviewed solution memory",
  "type": "object",
  "required": ["schema_version", "record_id", "problem_signature", "constraints", "selected_solution", "rejected_alternatives", "proof_refs", "reuse_conditions", "anti_conditions", "reviewer_role_id", "review_verdict", "freshness", "public_safe"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_id": {"type": "string", "minLength": 1},
    "problem_signature": {"type": "string", "minLength": 1},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "selected_solution": {"type": "string", "minLength": 1},
    "rejected_alternatives": {"type": "array", "items": {"type": "string"}},
    "source_refs": {"type": "array", "items": {"type": "string"}},
    "proof_refs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "reuse_conditions": {"type": "array", "items": {"type": "string"}},
    "anti_conditions": {"type": "array", "items": {"type": "string"}},
    "reviewer_role_id": {"type": "string", "minLength": 1},
    "review_verdict": {"enum": ["approve", "revise", "block"]},
    "freshness": {"enum": ["current", "review_due", "superseded"]},
    "supersedes": {"type": "array", "items": {"type": "string"}},
    "public_safe": {"const": true}
  },
  "additionalProperties": false
}
