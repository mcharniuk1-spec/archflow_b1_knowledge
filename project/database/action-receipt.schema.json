{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arch-flow.dev/schemas/action-receipt.schema.json",
  "title": "ArchFlow reviewed action receipt",
  "type": "object",
  "required": ["schema_version", "receipt_id", "run_id", "contract_hashes", "actor_role_id", "target_class", "authority_ref", "attempt", "artifact_hashes", "checks", "result", "rollback", "readback", "provider_calls", "external_writes", "reviewer_role_id", "review_verdict", "public_safe"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "receipt_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "contract_hashes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "actor_role_id": {"type": "string", "minLength": 1},
    "target_class": {"type": "string", "minLength": 1},
    "authority_ref": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "artifact_hashes": {"type": "array", "items": {"type": "string"}},
    "checks": {"type": "array", "items": {"type": "string"}},
    "result": {"enum": ["completed", "blocked", "failed", "cancelled"]},
    "rollback": {"type": "string"},
    "readback": {"enum": ["not_required", "pass", "fail", "pending"]},
    "provider_calls": {"type": "integer", "minimum": 0},
    "external_writes": {"type": "integer", "minimum": 0},
    "input_tokens": {"type": "integer", "minimum": 0},
    "output_tokens": {"type": "integer", "minimum": 0},
    "provider_cost_usd": {"type": "number", "minimum": 0},
    "reviewer_role_id": {"type": "string", "minLength": 1},
    "review_verdict": {"enum": ["approve", "revise", "block"]},
    "public_safe": {"const": true}
  },
  "additionalProperties": false
}
